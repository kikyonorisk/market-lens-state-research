# demo | fuyao. demo 数据为构造样本；fuyao 模式不会在失败时回退到演示数据。
MARKET_DATA_MODE=demo
PORT=4173

# 扶摇 REST API（服务端读取，绝不发送到浏览器）
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# 可选：连接 iFinD 市场数据与新闻 MCP；Authorization header 值应原样填入，仅供服务端读取。
# 两个服务分别授权；未配置时对应维度不可用，不影响扶摇主链路。
IFIND_MARKET_AUTHORIZATION=
IFIND_NEWS_AUTHORIZATION=

# 可选：OpenAI-compatible Chat Completions 服务。缺少任一项时，Research 明确提示模型不可用。
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
